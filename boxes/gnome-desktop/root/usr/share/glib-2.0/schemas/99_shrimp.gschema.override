# Shrimp defaults. Loaded after the openSUSE branding overrides.

[org.gnome.desktop.background]
picture-uri='file:///usr/share/backgrounds/shrimp/mont-blanc.jpg'
picture-uri-dark='file:///usr/share/backgrounds/shrimp/mont-blanc.jpg'
picture-options='zoom'
primary-color='#000000'
secondary-color='#000000'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/backgrounds/shrimp/mont-blanc.jpg'
picture-options='zoom'
primary-color='#000000'
secondary-color='#000000'

[org.gnome.desktop.interface]
accent-color='blue'
# main icon theme (installed by the icon-theme box, inherits Adwaita)
icon-theme='MoreWaita'
clock-format='24h'
# top bar: weekday next to the date, battery level in percent
clock-show-weekday=true
show-battery-percentage=true

[org.gnome.desktop.input-sources]
sources=[('xkb', 'pl')]

[org.gnome.desktop.wm.preferences]
button-layout='appmenu:minimize,maximize,close'

[org.gnome.shell]
enabled-extensions=['shrimp-setup-guard@shrimp', 'shrimp-menu@shrimp', 'ding@rastersoft.com', 'blur-my-shell@aunetx', 'dash-to-dock@micxgx.gmail.com', 'just-perfection-desktop@just-perfection', 'light-style@gnome-shell-extensions.gcampax.github.com']
disable-user-extensions=false
# Dock at the start (owner, 2026-11-13): browser, Steam, Files, store, Calculator, Calendar, LibreOffice,
# Settings; nothing that needs knowing the system (Cherry, Panko). Onboarding puts the browser the user
# chose in place of Firefox. Apps that are not installed yet (Flatpaks from the first configuration)
# simply do not show until they are.
favorite-apps=['org.mozilla.firefox.desktop', 'com.valvesoftware.Steam.desktop', 'org.shrimp.Filer.desktop', 'org.shrimp.Apps.desktop', 'org.gnome.Calculator.desktop', 'org.gnome.Calendar.desktop', 'org.libreoffice.LibreOffice.desktop', 'org.gnome.Settings.desktop']
welcome-dialog-last-shown-version='999'

# Just Perfection: no Activities button in the top bar
[org.gnome.shell.extensions.just-perfection]
activities-button=false

# Blur my Shell: the wallpaper is blurred in the Overview, the top bar stays sharp
[org.gnome.shell.extensions.blur-my-shell.overview]
blur=true

[org.gnome.shell.extensions.blur-my-shell.panel]
blur=false

# Dock: real (dynamic) blur of what is behind it. The default static blur only blurs the wallpaper, so
# windows under the dock showed through sharp (owner's review, 2026-11-13).
[org.gnome.shell.extensions.blur-my-shell.dash-to-dock]
blur=true
static-blur=false

[org.gnome.shell.extensions.dash-to-dock]
dock-position='BOTTOM'
dock-fixed=false
intellihide=true
show-trash=false
show-mounts=false

[org.gnome.shell.extensions.ding]
show-home=true
show-trash=true
show-volumes=false

[org.gnome.mutter]
# New windows open in the middle of the screen, as in Windows.
center-new-windows=true
# Fractional scaling (125 %, 150 %) in Settings › Displays, and sharp X11 apps when scaled: Electron apps
# run through XWayland so GNOME draws their title bar (shrimp-app-style).
experimental-features=['scale-monitor-framebuffer', 'xwayland-native-scaling']

# Windows keyboard habits: Super+D shows the desktop, Super+E opens the home folder (in Filer).
[org.gnome.desktop.wm.keybindings]
show-desktop=['<Super>d']

[org.gnome.settings-daemon.plugins.media-keys]
home=['<Super>e']
