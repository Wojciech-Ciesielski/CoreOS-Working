#!/bin/bash
# Pomocnik Setup Shrimp uruchamiany przez pkexec na końcu pierwszej konfiguracji.
#   shrimp-setup-apply --codecs yes|no --nvidia nvidia|open|none [--apps "id1 id2"] [--auto-updates yes|no]
#   shrimp-setup-apply --later   (shrimp-setup-later.service: to, co czekało na internet)
# Instaluje kodeki i sterownik w jednej migawce (transactional-update), zdejmuje logowanie
# automatyczne i znacznik pierwszego uruchomienia. Wypisuje „reboot”, gdy potrzebny restart.
# Bez internetu (instalacja offline, brak karty Wi-Fi, brak kabla) pierwsza konfiguracja kończy się normalnie,
# a kodek H.264, sterownik NVIDIA i wybrane programy czekają w $STATE/later: shrimp-setup-later.timer
# doinstaluje je sam, gdy komputer połączy się z siecią.
set -euo pipefail
CODECS=no; NVIDIA=none; APPS=""; LATER=no; AUTO=yes
while [ $# -gt 0 ]; do
  case "$1" in
    --codecs) CODECS=$2; shift 2 ;;
    --nvidia) NVIDIA=$2; shift 2 ;;
    --apps) APPS=$2; shift 2 ;;
    --auto-updates) AUTO=$2; shift 2 ;;
    --later) LATER=yes; shift ;;
    *) echo "nieznany argument: $1" >&2; exit 2 ;;
  esac
done
STATE=${SHRIMP_STATE:-/var/lib/shrimp-setup}
online() { [ -n "${SHRIMP_ONLINE:-}" ] && { [ "$SHRIMP_ONLINE" = 1 ]; return; }; curl -fsI -m 10 https://download.opensuse.org/ >/dev/null 2>&1; }
if [ "$LATER" = yes ]; then
  [ -f "$STATE/later" ] || exit 0
  online || { echo "shrimp-setup-apply: nadal bez internetu, czekam" >&2; exit 0; }
  # shellcheck source=/dev/null
  . "$STATE/later"
else
  [ -f "$STATE/first-boot" ] || { echo "pierwsza konfiguracja już zakończona" >&2; exit 1; }
fi
# Pierwsza konfiguracja bez internetu: wybory zapisane na później, pakiety nie są nawet szukane.
OFFLINE=no
if [ "$LATER" = no ] && ! online; then
  OFFLINE=yes
  printf 'CODECS=%q\nNVIDIA=%q\nAPPS=%q\n' "$CODECS" "$NVIDIA" "$APPS" > "$STATE/later"
  echo "shrimp-setup-apply: bez internetu, kodeki/NVIDIA/programy później (shrimp-setup-later)" >&2
elif [ "$LATER" = no ] && [ -n "$APPS" ]; then
  # Sieć wróciła dopiero pod koniec: programy, które nie zdążyły wejść, i tak doinstaluje shrimp-setup-later.
  printf 'CODECS=no\nNVIDIA=none\nAPPS=%q\n' "$APPS" > "$STATE/later"
fi
# shellcheck source=/dev/null
. "${SHRIMP_DRIVERS_CONF:-/usr/share/shrimp/linux/drivers.conf}"
# Wybór wersji otwartego modułu NVIDIA (wspólny z budową nośnika); dołączany w migawce.
NVIDIA_LIB=${SHRIMP_NVIDIA_LIB:-/usr/share/shrimp/linux/nvidia-open.sh}

# Pierwsza karta NVIDIA: identyfikator urządzenia PCI (np. 0x2504) albo pusto.
nvidia_device() {
  local d
  for d in "${SHRIMP_SYSFS:-/sys}"/bus/pci/devices/*; do
    [ "$(cat "$d/vendor" 2>/dev/null)" = 0x10de ] || continue
    case "$(cat "$d/class" 2>/dev/null)" in 0x03*) cat "$d/device"; return ;; esac
  done
}
secure_boot() { mokutil --sb-state 2>/dev/null | grep -qi "SecureBoot enabled"; }

# Sterowniki i firmware urządzeń (DRIVER_PACKAGES, wolne do rozpowszechniania): zawsze, po kodekach.
PKGS=()
if [ "$CODECS" = yes ]; then
  read -ra PKGS <<<"$CODEC_PACKAGES $OPENH264_PACKAGES"
  # openh264 od Cisco: repozytorium dokłada zwykle openSUSE-repos-Leap; gdy go nie ma, dodajemy je wprost.
  read -r H264 _ <<<"$OPENH264_PACKAGES"
  if ! zypper --non-interactive --quiet search --match-exact "$H264" >/dev/null 2>&1; then
    zypper --non-interactive addrepo --refresh "$OPENH264_REPO_URL" "$OPENH264_REPO_ALIAS" >&2 \
      && zypper --non-interactive --gpg-auto-import-keys refresh "$OPENH264_REPO_ALIAS" >&2 \
      || echo "shrimp-setup-apply: repozytorium openh264 niedostępne" >&2
  fi
fi

read -ra DRV_PKGS <<<"${DRIVER_PACKAGES:-}"
PKGS+=("${DRV_PKGS[@]}")

# Polecenia wykonywane w nowej migawce (transactional-update run), wszystko naraz.
NV_SCRIPT=""
DEV=$(nvidia_device)
if [ "$NVIDIA" = nvidia ] && [ -n "$DEV" ]; then
  if [ $((DEV)) -ge $((NVIDIA_TURING_MIN_ID)) ]; then
    NV_KIND=open
  elif secure_boot; then
    NV_KIND=none
    echo "shrimp-setup-apply: starsza karta NVIDIA ($DEV) i Secure Boot: zostaje sterownik otwarty" >&2
  else
    NV_KIND=legacy
  fi
  if [ "$NV_KIND" != none ]; then
    NV_SCRIPT=$(cat <<SCRIPT
set -e
zypper --non-interactive install --no-recommends $NVIDIA_REPO_PACKAGE \\
  || zypper --non-interactive addrepo --refresh "$NVIDIA_REPO_URL" $NVIDIA_REPO_ALIAS || true
zypper --non-interactive --gpg-auto-import-keys refresh
pick() { for p in "\$@"; do zypper --non-interactive --quiet search --match-exact "\$p" >/dev/null 2>&1 && echo "\$p"; done; }
# usługi uśpienia sterownika (bez nich GDM nie włącza Waylanda na NVIDIA); opcje: 61-shrimp-nvidia.conf
services() { for u in $NVIDIA_SERVICES; do systemctl enable "\$u" 2>/dev/null || true; done; }
if [ $NV_KIND = open ]; then
  # moduł w najnowszej wersji, do której SUSE ma podpisany moduł jądra (nvidia-open.sh), biblioteki w tej wersji
  . "$NVIDIA_LIB"
  for S in $NVIDIA_OPEN_SERIES; do
    if ver=\$(nvidia_open_install "\$S"); then
      for p in \$(echo "$NVIDIA_OPEN_PACKAGES" | sed "s/@S@/\$S/g"); do
        case "\$p" in *kmp*) continue ;; esac
        zypper --non-interactive install --no-recommends --auto-agree-with-licenses "\$p = \$ver" \\
          || echo "brak pakietu \$p \$ver" >&2
      done
      services; exit 0
    fi
  done
  echo "brak pakietów otwartego sterownika NVIDIA" >&2; exit 1
else
  zypper --non-interactive install --auto-agree-with-licenses \$(pick $NVIDIA_LEGACY_PACKAGES); services
fi
SCRIPT
)
  fi
fi

REBOOT=no
[ "$OFFLINE" = yes ] && { PKGS=(); NV_SCRIPT=""; }
if [ ${#PKGS[@]} -gt 0 ]; then
  # Pakiety, których nie ma w repozytoriach, nie blokują reszty.
  AVAIL=()
  for p in "${PKGS[@]}"; do
    if zypper --non-interactive --quiet search --match-exact "$p" >/dev/null 2>&1; then AVAIL+=("$p"); else echo "brak pakietu: $p" >&2; fi
  done
  if [ ${#AVAIL[@]} -gt 0 ]; then
    NV_SCRIPT="zypper --non-interactive install --no-recommends ${AVAIL[*]}
$NV_SCRIPT"
  fi
fi
if [ -n "$NV_SCRIPT" ]; then
  # Jedna migawka: kodeki i sterownik razem, aktywne po restarcie.
  if transactional-update --non-interactive run bash -c "$NV_SCRIPT" >&2; then
    REBOOT=yes
    # Po restarcie: pasujące biblioteki GL NVIDIA dla aplikacji z Flathub (np. Steam).
    [ -n "$DEV" ] && [ "$NVIDIA" = nvidia ] && touch "$STATE/nvidia-flatpak"
  else
    echo "shrimp-setup-apply: transactional-update nie powiodło się" >&2
    # Później: kilka prób przy kolejnych uruchomieniach licznika (sieć mogła zniknąć w trakcie), potem programy i koniec.
    if [ "$LATER" = yes ] && [ "${FAILS:-0}" -lt 4 ]; then
      printf 'CODECS=%q\nNVIDIA=%q\nAPPS=%q\nFAILS=%q\n' "$CODECS" "$NVIDIA" "$APPS" "$((${FAILS:-0} + 1))" > "$STATE/later"
      exit 1
    fi
  fi
fi

if [ "$LATER" = yes ]; then
  # Programy z pierwszej konfiguracji (zestaw podstawowy i wybór użytkownika), potem koniec czekania.
  SA=/usr/bin/shrimp-apps
  if [ -x "$SA" ] && [ -f /usr/share/shrimp/base-apps.json ]; then "$SA" --install --base >&2 || echo "shrimp-setup-apply: zestaw podstawowy nie wszedł" >&2; fi
  flatpak remote-add --system --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo >&2 || true
  for a in $APPS; do
    if [ -x "$SA" ]; then "$SA" --install "$a" >&2; else flatpak install --system --noninteractive -y flathub "$a" >&2; fi \
      || echo "shrimp-setup-apply: program $a nie wszedł" >&2
  done
  rm -f "$STATE/later"
  echo "shrimp-setup-apply: doinstalowane po połączeniu z siecią" >&2
  [ "$REBOOT" = yes ] && echo reboot
  exit 0
fi

# Koniec pierwszej konfiguracji. Aktualizacje w tle (domyślnie tak): nowa migawka bez restartu,
# zmiany wchodzą przy następnym uruchomieniu komputera.
AU=${SHRIMP_AUTO_UPDATES:-/usr/libexec/shrimp-auto-updates}
if [ -x "$AU" ]; then
  if [ "$AUTO" = no ]; then "$AU" off >&2; else "$AU" on >&2; fi
fi
sed -i 's/^DISPLAYMANAGER_AUTOLOGIN=.*/DISPLAYMANAGER_AUTOLOGIN=""/' /etc/sysconfig/displaymanager 2>/dev/null || true
if [ -f /etc/gdm/custom.conf ]; then
  sed -i 's/^AutomaticLoginEnable=.*/AutomaticLoginEnable=False/; /^AutomaticLogin=/d' /etc/gdm/custom.conf
fi
rm -f "$STATE/first-boot"
# Setup znika z systemu: bez autostartu (okno i tak by od razu kończyło, a strażnik Setup wyłącza się
# razem ze znacznikiem). Program zostaje w /usr (system tylko do odczytu), ale nic go już nie uruchamia.
rm -f "${SHRIMP_AUTOSTART_DIR:-/etc/xdg/autostart}/shrimp-setup-first-boot.desktop"
[ "$REBOOT" = yes ] && echo reboot
exit 0
