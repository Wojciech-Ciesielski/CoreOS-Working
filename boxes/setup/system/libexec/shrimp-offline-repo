#!/bin/bash
# Nośnik Shrimp: repozytorium pakietów na pendrivie (instalacja bez internetu).
# Shrimp Install kopiuje LiveOS/ z obrazu na partycję exFAT, więc plik leży obok squashfs.img:
#   LiveOS/shrimp-repo.squashfs → /run/shrimp-repo (tylko do odczytu).
# Gdy jest, produkt Agamy (shrimp.yaml) instaluje z niego zamiast z download.opensuse.org.
# Bez pliku (starszy nośnik) nic się nie zmienia: instalacja z internetu jak dotąd.
set -euo pipefail
MNT=/run/shrimp-repo
PRODUCT=/usr/share/agama/products.d/shrimp.yaml
log() { echo "shrimp-offline-repo: $*"; }

img=""
for d in /run/overlay/live /run/initramfs/live /run/media/*/SHRIMP_LIVE; do
  [ -f "$d/LiveOS/shrimp-repo.squashfs" ] && { img=$d/LiveOS/shrimp-repo.squashfs; break; }
done
# Na prawdziwym sprzęcie partycja exFAT bywa podpięta gdzie indziej (albo wcale): szukamy jej po etykiecie
# wśród wszystkich punktów montowania, a w ostateczności podpinamy ją sami tylko do odczytu.
if [ -z "$img" ]; then
  for t in $(findmnt -rn -o TARGET 2>/dev/null); do
    [ -f "$t/LiveOS/shrimp-repo.squashfs" ] && { img=$t/LiveOS/shrimp-repo.squashfs; break; }
  done
fi
if [ -z "$img" ]; then
  for i in $(seq 10); do dev=$(blkid -L SHRIMP_LIVE 2>/dev/null || true); [ -n "$dev" ] && break; sleep 1; done
  if [ -n "${dev:-}" ]; then
    mkdir -p /run/shrimp-live
    mountpoint -q /run/shrimp-live || mount -o ro "$dev" /run/shrimp-live 2>/dev/null || mount -t exfat -o ro "$dev" /run/shrimp-live || true
    [ -f /run/shrimp-live/LiveOS/shrimp-repo.squashfs ] && img=/run/shrimp-live/LiveOS/shrimp-repo.squashfs
  fi
  log "szukanie po etykiecie SHRIMP_LIVE: urządzenie '${dev:-brak}', obraz '${img:-brak}'"
fi
[ -n "$img" ] || { log "brak repozytorium na nośniku, instalacja z internetu"; lsblk -f 2>&1 | sed 's/^/shrimp-offline-repo: /'; findmnt -rn 2>&1 | grep -i live | sed 's/^/shrimp-offline-repo: /'; exit 0; }

mkdir -p "$MNT"
mountpoint -q "$MNT" || mount -t squashfs -o loop,ro "$img" "$MNT"
# install/: podpisane repozytorium openSUSE (z niego Agama). extra/ (bez podpisu) jest tylko dla
# post-install.sh: wskazane Agamie kończyło się pytaniem o niepodpisane repozytorium i zawieszeniem
# na „Refreshing metadata” (test QEMU: find wybrał extra/ zamiast install/).
repo=$MNT/install
[ -f "$repo/repodata/repomd.xml" ] || { log "$img bez install/repodata/repomd.xml"; exit 0; }
# Klucze, którymi openSUSE podpisało to repozytorium, jako zaufane (Agama importuje klucze z
# /usr/lib/rpm/gnupg/keys/). Bez tego libzypp pyta o zaufanie do klucza, nikt nie odpowiada
# i Agama stoi na „Refreshing metadata from the repositories” (test QEMU bez sieci).
for k in "$repo"/gpg-pubkey-*.asc; do
  [ -f "$k" ] || continue
  install -Dm644 "$k" "/usr/lib/rpm/gnupg/keys/$(basename "$k")"
  rpm --import "$k" 2>/dev/null || true
done
# Klucz openSUSE z repodata install/ i jednorazowy klucz budowy, którym podpisane jest extra/.
for k in "$repo/repodata/repomd.xml.key:install" "$MNT/extra/repodata/repomd.xml.key:extra"; do
  f=${k%:*}
  [ -f "$f" ] || continue
  install -Dm644 "$f" "/usr/lib/rpm/gnupg/keys/gpg-pubkey-shrimp-offline-${k##*:}.asc"
  rpm --import "$f" 2>/dev/null || true
done
# Jedyne repozytorium instalacji w produkcie: lokalne (internet nie jest potrzebny ani sprawdzany).
# extra/ (pakiety spoza repozytorium Leap, np. exfatprogs dla partycji exFAT pendrive'a) jako drugie.
if [ -f "$MNT/extra/repodata/repomd.xml.asc" ]; then
  sed -i -E "s#^( *)- url: https?://download\.opensuse\.org/.*#\1- url: dir://$repo\n\1- url: dir://$MNT/extra#" "$PRODUCT"
else
  sed -i -E "s#^( *- url: )https?://download\.opensuse\.org/.*#\1dir://$repo#" "$PRODUCT"
fi
grep -q "dir://$repo" "$PRODUCT" || { log "nie udało się ustawić repozytorium w $PRODUCT"; exit 1; }
log "instalacja offline z $img ($repo)"
