# Tylko nośnik instalacyjny: tło jak ekran startu (czarne, logo Shrimp na środku). Zwykle kreator działa
# w sesji kiosku (bez powłoki GNOME); te ustawienia dotyczą pulpitu GNOME nośnika testowego (dysk SHRIMP_TEST):
# bez rozszerzeń (ikony pulpitu, dok) i bez okna powitalnego.
# Zainstalowany system tego pliku nie dostaje (post-install.sh kopiuje tylko 99_shrimp).
[org.gnome.desktop.background]
picture-uri='file:///usr/share/shrimp-setup/live/shrimp-live-background.svg'
picture-uri-dark='file:///usr/share/shrimp-setup/live/shrimp-live-background.svg'
picture-options='centered'
primary-color='#000000'
color-shading-type='solid'

[org.gnome.desktop.screensaver]
picture-uri='file:///usr/share/shrimp-setup/live/shrimp-live-background.svg'
picture-options='centered'
primary-color='#000000'

[org.gnome.shell]
enabled-extensions=@as []
welcome-dialog-last-shown-version='999'
