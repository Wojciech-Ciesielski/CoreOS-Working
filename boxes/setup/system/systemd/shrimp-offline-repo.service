[Unit]
Description=Shrimp: repozytorium pakietów z nośnika (instalacja bez internetu)
# Agama czyta produkty przy starcie, więc repozytorium musi być ustawione wcześniej.
Before=agama.service agama-web-server.service
After=local-fs.target
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/shrimp-offline-repo

[Install]
WantedBy=multi-user.target
