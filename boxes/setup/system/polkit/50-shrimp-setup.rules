// Shrimp: instalacja programów z Flathub dla administratorów (grupa wheel) w lokalnej, aktywnej sesji
// bez pytania o hasło (Shrimp Apps, programy wybrane w kreatorze).
polkit.addRule(function (action, subject) {
  if (!subject.local || !subject.active || !subject.isInGroup("wheel")) return polkit.Result.NOT_HANDLED;
  if (action.id == "org.freedesktop.Flatpak.app-install" ||
      action.id == "org.freedesktop.Flatpak.runtime-install" ||
      action.id == "org.freedesktop.Flatpak.modify-repo") {
    return polkit.Result.YES;
  }
  return polkit.Result.NOT_HANDLED;
});
